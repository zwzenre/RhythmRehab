# Keep Unity scenes and metadata readable in diffs. Preserve binary assets.
* text=auto
*.cs text
*.shader text
*.json text
*.md text
*.unity text
*.prefab text
*.asset text
*.meta text
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.FBX binary
*.ttf binary
*.otf binary
